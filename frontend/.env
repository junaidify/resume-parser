# ==============================================================================
# Resume Parser & File Upload Backend Configuration
# ==============================================================================

# Base URL for the Backend API service
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Endpoint for processing & uploading document attachments
VITE_UPLOAD_ENDPOINT=/resumes/upload

# Maximum upload file size in Megabytes (MB)
VITE_MAX_FILE_SIZE_MB=25

# Allowed file extensions for attachments (comma-separated)
VITE_ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.png,.jpg,.jpeg,.fig,.ae,.ai

# Optional API Key or Auth Token placeholder for backend request headers
VITE_API_KEY=your_api_key_here
